# Requires radare2 ABI 163 or newer.
NAME=inline defaults to enabled and respects the config toggle and callee mark
FILE=malloc://256
ARGS=-a x86 -b64
CMDS=<<EOF
wx e83b00000083c002c3
wx b807000000c3 @ 0x40
af child @ 0x40
af caller @ 0
e r2ghidra.inline
pdg @ 0~child(~?
afia+ inline @ 0x40
pdg @ 0~child(~?
pdg @ 0~return 9
e r2ghidra.inline=false
pdg @ 0~child(~?
e r2ghidra.inline=true
pdg @ 0~child(~?
afia- inline @ 0x40
pdg @ 0~child(~?
EOF
EXPECT=<<EOF
true
1
0
    return 9;
1
0
1
EOF
RUN

NAME=inline external function loaded in another IO map
