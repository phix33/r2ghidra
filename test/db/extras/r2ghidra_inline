NAME=inline callee keeps both early returns and the caller continuation
FILE=malloc://256
ARGS=-a x86 -b64
CMDS=<<EOF
wx e83b00000083c002c3
wx 85ff7406b807000000c3b809000000c3 @ 0x40
af child @ 0x40
af caller @ 0
afia+ inline @ 0x40
pdg @ 0~child(~?
pdg @ 0~iVar1 = 9,iVar1 = 7,return iVar1 + 2
EOF
EXPECT=<<EOF
0
        iVar1 = 9;
        iVar1 = 7;
    return iVar1 + 2;
EOF
RUN

NAME=inline recursion keeps the recursive call
FILE=malloc://256
ARGS=-a x86 -b64
CMDS=<<EOF
wx e83b00000083c002c3
wx e8fbffffff83c001c3 @ 0x40
af child @ 0x40
af caller @ 0
afia+ inline @ 0x40
pdg @ 0~Could not inline here~?
pdg @ 0~child(~?
pdg @ 0~return iVar1 + 3
EOF
EXPECT=<<EOF
