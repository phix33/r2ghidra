ARGS=-a x86 -b64
CMDS=<<EOF
o malloc://256 0x1000
ompg +x
wx b807000000c3 @ 0x1000
wx e8fb0f000083c002c3 @ 0
af sym.imp.external_child @ 0x1000
af caller @ 0
afia+ inline @ 0x1000
pdg @ 0~external_child(~?
pdg @ 0~return 9
EOF
EXPECT=<<EOF
0
    return 9;
EOF
RUN

